{
  "Storage": {
    "Endpoint": "https://storage.getitdone.com.ph",
    "Region": "us-east-1",
    "Bucket": "get-it-done-production"
  },
  "Keycloak": {
    "Authority": "https://auth.getitdone.com.ph/realms/get-it-done-dev",
    "Audience": "get-it-done-ebyahe-api"
  },
  "Kafka": {
    "Enabled": false,
    "ConsumerEnabled": true,
    "BootstrapServers": "",
    "Topic": "get-it-done.account.users.v1",
    "ConsumerGroup": "get-it-done-ebyahe-account-users-v1",
    "ClientId": "get-it-done-ebyahe",
    "SecurityProtocol": "Ssl",
    "RetryDelaySeconds": 5
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
